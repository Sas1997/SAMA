# Files included in the source distribution (sdist).
# Wheel contents are set by package-data in pyproject.toml.

# Package data
recursive-include src/samapy/content *

# Top-level files
include README.md
include LICENSE
include requirements.txt
include pyproject.toml

# Examples and tests
recursive-include examples *.py *.csv *.yaml *.yml
recursive-include tests *.py

# Excluded files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.pyo
global-exclude .DS_Store
global-exclude Thumbs.db
prune dist
prune build
prune *.egg-info
